{
  "name": "Broadsheet Weather",
  "short_name": "Broadsheet",
  "description": "An editorial print-inspired meteorological broadsheet for Android.",
  "start_url": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f8f2e6",
